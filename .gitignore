bookclub.db
# No .gitkeep needed: the bot creates this directory itself on startup.
# (A negated !/logs/.gitkeep would not work anyway — git never descends into
# an excluded directory, so a rule for a file inside it can never re-include it.)
/logs/
# runtime state written into the docker-compose bind mount (bookclub.db,
# bot_persistence) — see docker-compose.yml's ./data:/app/data volume.
# No .gitkeep needed: `docker compose up` creates the directory itself.
/data/
__pycache__/
*.pyc
.venv/
# database backups (bookclub_dbs/, philoclub_dbs/, …)
*_dbs/
backups/
*.env
scripts/deploy_bots.local.sh
scripts/deploy_bots.log
